{
    "name": "majpanel/majpanel-bundle",
    "description": "Reusable Majpanel administration bundle for Symfony applications.",
    "type": "symfony-bundle",
    "license": "GPL-2.0-or-later",
    "require": {
        "api-platform/doctrine-orm": "^4.3",
        "api-platform/symfony": "^4.3",
        "doctrine/doctrine-bundle": "^2.19",
        "doctrine/doctrine-migrations-bundle": "^3.7",
        "doctrine/migrations": "^3.7",
        "doctrine/orm": "^3.6",
        "php": ">=8.2",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/filesystem": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/password-hasher": "^7.4 || ^8.0",
        "symfony/routing": "^7.4 || ^8.0",
        "symfony/security-bundle": "^7.4 || ^8.0",
        "symfony/security-csrf": "^7.4 || ^8.0",
        "symfony/security-http": "^7.4 || ^8.0",
        "symfony/string": "^7.4 || ^8.0",
        "symfony/translation": "^7.4 || ^8.0",
        "symfony/twig-bundle": "^7.4 || ^8.0",
        "symfony/ux-react": "^2.36 || ^3.0",
        "symfony/webpack-encore-bundle": "^2.4",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/phpunit-bridge": "^7.4 || ^8.0",
        "symfony/ux-turbo": "^2.36"
    },
    "autoload": {
        "psr-4": {
            "Majpanel\\MajpanelBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Majpanel\\MajpanelBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true
        }
    },
    "config": {
        "sort-packages": true
    }
}
